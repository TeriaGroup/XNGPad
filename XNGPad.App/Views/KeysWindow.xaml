<Window x:Class="XNGPad.App.Views.KeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640"
        Height="560"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenAllButton" Style="{StaticResource LangButton}" Margin="0,0,8,0" Click="OpenAll_Click"/>
                <Button x:Name="CloseButton" Style="{StaticResource LangButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="HintText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding KeyName}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/>
                                <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}"
                                         FontSize="12" Padding="8,4" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         FontSize="13" Padding="8,4" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="SiteButton" Style="{StaticResource BarButton}" Height="32" Padding="10,0" Margin="0,0,8,0"
                                            Click="Site_Click" Tag="{Binding}"/>
                                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Height="32" Padding="10,0"
                                            Click="Save_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
