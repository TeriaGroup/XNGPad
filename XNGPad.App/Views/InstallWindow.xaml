<Window x:Class="XNGPad.App.Views.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[Install]}"
        Width="840"
        Height="560"
        MinWidth="760"
        MinHeight="480"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <DataTemplate x:Key="McpCard">
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,10,10">
                <StackPanel Margin="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBlock FontSize="13" FontFamily="Segoe UI" Margin="0,8,0,0">
                        <Hyperlink Command="{Binding OpenGitHubCommand}" Foreground="{StaticResource AccentBrush}" TextDecorations="None">GitHub</Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding OpenGuideCommand}" Foreground="{StaticResource MutedBrush}" TextDecorations="None">
                            <Run Text="{Binding DetailsText}"/>
                        </Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding SetTokenCommand}" Foreground="{StaticResource MutedBrush}" TextDecorations="None">
                            <Run Text="{Binding TokenText}"/>
                        </Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding MuteCommand}" Foreground="{StaticResource MutedBrush}" TextDecorations="None">
                            <Run Text="{Binding MuteText}"/>
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}"
                            Style="{StaticResource BarButton}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="McpGrid" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource McpCard}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16,12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Loc[Install]}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Loc[ReissueKeys]}" Command="{Binding OpenKeysCommand}"
                        Style="{StaticResource LangButton}" Margin="0,0,8,0"/>
                <Button Content="{Binding Loc[Close]}" Click="Close_Click" Style="{StaticResource LangButton}"/>
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[InstallHint]}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" FontSize="12" Margin="0,0,0,8">
            <Hyperlink NavigateUri="https://registry.modelcontextprotocol.io/" RequestNavigate="Link_Click">MCP Registry</Hyperlink>
            <Run Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
            <Hyperlink NavigateUri="https://github.com/punkpeye/awesome-mcp-servers" RequestNavigate="Link_Click">awesome-mcp-servers</Hyperlink>
            <Run Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
            <Hyperlink NavigateUri="https://glama.ai/mcp/servers" RequestNavigate="Link_Click">Glama</Hyperlink>
            <Run Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
            <Hyperlink NavigateUri="https://github.com/mcp" RequestNavigate="Link_Click">GitHub Registry</Hyperlink>
        </TextBlock>
        <ProgressBar DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Margin="0,0,0,6"
                     Visibility="{Binding ShowInstallProgress, Converter={StaticResource BoolVis}}"
                     Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding BusyText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"
                   Visibility="{Binding BusyText, Converter={StaticResource StrVis}}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" MaxHeight="96"
                   Visibility="{Binding ShowDownloadQueue, Converter={StaticResource BoolVis}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[QueueTitle]}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DownloadJobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Node.js" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="{Binding NodeInstallStatus}" FontWeight="SemiBold" Margin="6,0,20,0"/>
            <TextBlock Text="Docker" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="{Binding DockerInstallStatus}" FontWeight="SemiBold" Margin="6,0,20,0"/>
            <TextBlock Text="OpenCode" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="{Binding OpenCodeInstallStatus}" FontWeight="SemiBold" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{Binding Loc[InstallNode]}" Command="{Binding InstallNodeCommand}" Style="{StaticResource AccentButton}"
                    Height="32" FontSize="13" Margin="0,0,8,0" Padding="12,0"
                    Visibility="{Binding ShowInstallNode, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding Loc[InstallDockerApp]}" Command="{Binding InstallDockerCommand}" Style="{StaticResource AccentButton}"
                    Height="32" FontSize="13" Margin="0,0,8,0" Padding="12,0"
                    Visibility="{Binding ShowInstallDocker, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding Loc[InstallOpenCode]}" Command="{Binding InstallOpenCodeCommand}" Style="{StaticResource AccentButton}"
                    Height="32" FontSize="13" Padding="12,0"
                    Visibility="{Binding ShowInstallOpenCode, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{Binding Loc[McpAvailable]}" Command="{Binding SetInstallPageCommand}" CommandParameter="catalog">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallIsCatalog}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding Loc[McpUsed]}" Command="{Binding SetInstallPageCommand}" CommandParameter="used">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallIsUsed}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <TextBox DockPanel.Dock="Top" Text="{Binding McpSearch, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldBox}" Padding="8,5" FontSize="13" Margin="0,0,0,6"
                 ToolTip="{Binding Loc[McpSearch]}"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{Binding Loc[FilterAll]}" Command="{Binding SetMcpFilterCommand}" CommandParameter="all">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterIsAll}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding Loc[FilterKey]}" Command="{Binding SetMcpFilterCommand}" CommandParameter="key">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterIsKey}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding Loc[FilterNoKey]}" Command="{Binding SetMcpFilterCommand}" CommandParameter="nokey">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterIsNoKey}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding Loc[FilterNpm]}" Command="{Binding SetMcpFilterCommand}" CommandParameter="npm">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterIsNpm}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding Loc[FilterRemote]}" Command="{Binding SetMcpFilterCommand}" CommandParameter="remote">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterIsRemote}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Banner}" TextWrapping="Wrap" Margin="2,8,2,0"
                   Visibility="{Binding Banner, Converter={StaticResource StrVis}}"
                   Foreground="{Binding BannerLevel, Converter={StaticResource BannerBrush}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                      Visibility="{Binding InstallIsUsed, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Loc[McpUsedEmpty]}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,8" FontSize="12"
                           Visibility="{Binding ShowUsedEmpty, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding UsedMcpRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,10,10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding DataContext.Loc[McpForget], RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.ForgetMcpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BarButton}" Height="32" Padding="12,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                      Visibility="{Binding InstallIsCatalog, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <StackPanel Visibility="{Binding ShowAddedMcps, Converter={StaticResource BoolVis}}">
                    <Button Command="{Binding ToggleAddedMcpsCommand}" Style="{StaticResource FoldHeader}">
                        <Grid>
                            <TextBlock Text="{Binding Loc[McpAdded]}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding AddedMcpsArrow}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <ItemsControl Style="{StaticResource McpGrid}" ItemsSource="{Binding AddedMcpRows}"
                                  Visibility="{Binding AddedMcpsExpanded, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowCatalogMcps, Converter={StaticResource BoolVis}}">
                    <Button Command="{Binding ToggleCatalogMcpsCommand}" Style="{StaticResource FoldHeader}">
                        <Grid>
                            <TextBlock Text="{Binding Loc[McpAvailable]}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding CatalogMcpsArrow}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <ItemsControl Style="{StaticResource McpGrid}" ItemsSource="{Binding CatalogMcpRows}"
                                  Visibility="{Binding CatalogMcpsExpanded, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowHiddenMcps, Converter={StaticResource BoolVis}}">
                    <Button Command="{Binding ToggleHiddenMcpsCommand}" Style="{StaticResource FoldHeader}">
                        <Grid>
                            <TextBlock Text="{Binding Loc[McpHidden]}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding HiddenMcpsArrow}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <ItemsControl Style="{StaticResource McpGrid}" ItemsSource="{Binding HiddenMcpRows}"
                                  Visibility="{Binding HiddenMcpsExpanded, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
