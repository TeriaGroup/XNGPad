<Window x:Class="XNGPad.App.Views.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="OpenSiteButton" Style="{StaticResource AccentButton}" Click="OpenSite_Click"/>
            <Button x:Name="CloseButton" Style="{StaticResource BarButton}" Margin="0" Click="Close_Click"/>
        </StackPanel>
        <TextBox x:Name="BodyText"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="14"
                 Background="{StaticResource InputBrush}"
                 Foreground="{StaticResource FgBrush}"
                 BorderThickness="0"
                 Padding="12"/>
    </DockPanel>
</Window>
