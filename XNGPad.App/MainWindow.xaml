<Window x:Class="XNGPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[AppTitle]}"
        Width="440"
        MinWidth="400"
        MinHeight="520"
        SizeToContent="Height"
        MaxHeight="900"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="OcSeg" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="McpCard">
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,0,10">
                <StackPanel Margin="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBlock FontSize="13" FontFamily="Segoe UI" Margin="0,8,0,0">
                        <Hyperlink Command="{Binding OpenGitHubCommand}"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextDecorations="None">GitHub</Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding OpenGuideCommand}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextDecorations="None">
                            <Run Text="{Binding DetailsText}"/>
                        </Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding SetTokenCommand}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextDecorations="None">
                            <Run Text="{Binding TokenText}"/>
                        </Hyperlink>
                        <Run Text="  "/>
                        <Hyperlink Command="{Binding MuteCommand}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextDecorations="None">
                            <Run Text="{Binding MuteText}"/>
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}"
                            Style="{StaticResource BarButton}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  Padding="20,16">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <TextBlock Text="{Binding Loc[AppTitle]}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Loc[LangRu]}"
                            Command="{Binding SetLanguageCommand}"
                            CommandParameter="ru">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRu}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="|" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Content="{Binding Loc[LangEn]}"
                            Command="{Binding SetLanguageCommand}"
                            CommandParameter="en">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding Loc[Settings]}"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource LangButton}"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsHome, Converter={StaticResource BoolVis}}"/>
                    <Button Content="{Binding Loc[SettingsBack]}"
                            Command="{Binding ClosePanelsCommand}"
                            Style="{StaticResource LangButton}"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsHome, Converter={StaticResource InvBoolVis}}"/>
                </StackPanel>
            </Grid>

            <StackPanel Visibility="{Binding IsHome, Converter={StaticResource BoolVis}}">
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,0,10">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{Binding DockerLevel, Converter={StaticResource LevelBrush}}" CornerRadius="4,0,0,4"/>
                        <Grid Margin="16,12,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Loc[Docker]}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DockerStatusText}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,0,10">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{Binding SearxngLevel, Converter={StaticResource LevelBrush}}" CornerRadius="4,0,0,4"/>
                        <Grid Margin="16,12,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Loc[Searxng]}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SearxngStatusText}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,0,16">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{Binding OpenCodeLevel, Converter={StaticResource LevelBrush}}" CornerRadius="4,0,0,4"/>
                        <Grid Margin="16,12,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Loc[OpenCode]}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding OpenCodeStatusText}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>

                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                             Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                           Visibility="{Binding BusyText, Converter={StaticResource StrVis}}"/>

                <Button Content="{Binding Loc[CheckAgain]}" Command="{Binding RefreshCommand}" Style="{StaticResource BarButton}"/>
                <Button Content="{Binding Loc[Install]}" Command="{Binding OpenInstallCommand}" Style="{StaticResource AccentButton}"/>
                <Button Content="{Binding Loc[DownloadDocker]}" Command="{Binding DownloadDockerCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowDownloadDocker, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Loc[DownloadDockerHint]}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,4,12"
                           Visibility="{Binding ShowDockerHint, Converter={StaticResource BoolVis}}"/>
                <Button Content="{Binding Loc[StartDocker]}" Command="{Binding StartDockerCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowStartDocker, Converter={StaticResource BoolVis}}"/>
                <Button Content="{Binding Loc[EnableSearxng]}" Command="{Binding EnableSearxngCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowEnableSearxng, Converter={StaticResource BoolVis}}"/>
                <Button Content="{Binding Loc[DisableSearxng]}" Command="{Binding DisableSearxngCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowDisableSearxng, Converter={StaticResource BoolVis}}"/>
                <Button Content="{Binding Loc[OpenSearxng]}" Command="{Binding OpenSearxngCommand}" Style="{StaticResource BarButton}"
                        Visibility="{Binding ShowOpenSearxng, Converter={StaticResource BoolVis}}"/>

                <Button Content="{Binding Loc[ConnectOpenCode]}" Command="{Binding ConnectOpenCodeCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowConnect, Converter={StaticResource BoolVis}}"/>
                <Grid Height="44" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding OpenCodePowerText}" Command="{Binding ToggleOpenCodeCommand}"
                            ToolTip="{Binding OpenCodePowerText}" Style="{StaticResource OcSeg}"
                            Background="{StaticResource AccentBrush}" Foreground="White"/>
                    <Button Grid.Column="2" Content="{Binding Loc[OcRestart]}" Command="{Binding RestartOpenCodeCommand}"
                            ToolTip="{Binding Loc[RestartOpenCode]}" Style="{StaticResource OcSeg}"
                            Background="{StaticResource BtnBrush}"/>
                </Grid>
                <Button Content="{Binding Loc[DownloadNode]}" Command="{Binding DownloadNodeCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowDownloadNode, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Margin="2,8,2,8"
                           Visibility="{Binding Banner, Converter={StaticResource StrVis}}"
                           Foreground="{Binding BannerLevel, Converter={StaticResource BannerBrush}}"/>
            </StackPanel>


            <StackPanel Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Loc[SettingsPort]}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding Loc[SettingsContainerName]}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditContainerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding Loc[SettingsSearxngUrl]}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditSearxngUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding Loc[SettingsOpenCodePath]}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditOpenCodePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DefaultOpenCodePath}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button Content="{Binding Loc[OpenOpenCodeFolder]}" Command="{Binding OpenOpenCodeFolderCommand}" Style="{StaticResource BarButton}"/>
                <Button Content="{Binding Loc[DisconnectOpenCode]}" Command="{Binding DisconnectOpenCodeCommand}" Style="{StaticResource BarButton}"
                        Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolVis}}"/>
                <Button Content="{Binding Loc[ShowLog]}" Command="{Binding ShowLogCommand}" Style="{StaticResource BarButton}"/>
                <TextBlock Text="{Binding Loc[SettingsLanguage]}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkCombo}" SelectedIndex="{Binding EditLanguageIndex, Mode=TwoWay}" Margin="0,0,0,20">
                    <ComboBoxItem Content="{Binding DataContext.Loc[SettingsLanguageOs], RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <ComboBoxItem Content="{Binding DataContext.Loc[SettingsLanguageRu], RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <ComboBoxItem Content="{Binding DataContext.Loc[SettingsLanguageEn], RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ComboBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding Loc[SettingsCancel]}" Command="{Binding CloseSettingsCommand}" Style="{StaticResource BarButton}" Margin="0"/>
                    <Button Content="{Binding Loc[SettingsSave]}" Grid.Column="2" Command="{Binding SaveSettingsCommand}" Style="{StaticResource AccentButton}" Margin="0"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
